{
  "model": "claude-sonnet-4-20250514",
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(pnpm *)",
      "Bash(git *)",
      "Bash(npx prettier:*)",
      "Bash(claude mcp:*)",
      "Bash(ccusage:*)",
      "Bash(curl:*)",
      "Read",
      "Task",
      "WebSearch",
      "WebFetch",
      "mcp__context7",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs",
      "mcp__github",
      "mcp__playwright__*"
    ],
    "deny": ["Read(./.env*)", "Read(./secrets/**)", "Bash(rm -rf:*)"],
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/research-gate.py",
            "description": "Blocks code changes without completed research phase"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/interview-gate.py",
            "description": "Blocks implementation without interview decisions"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/schema-gate.py",
            "description": "Blocks implementation without approved schema"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/tdd-gate.py",
            "description": "Enforces tests-before-implementation for TDD"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/validate-bash.py",
            "description": "Validates bash commands for safety"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/auto-answer.py",
            "description": "Auto-selects comprehensive options in autonomous mode"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format.py",
            "description": "Auto-formats code after changes"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/state-manager.py",
            "description": "Updates workflow state after file changes"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/registry-manager.py",
            "description": "Updates artifact registry with checksums"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/registry-update.py",
            "description": "Adds APIs/components/pages to registry.json"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/code-review.py",
            "description": "Queues files for AI code review"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/visual-qa.py",
            "description": "Queues UI files for visual testing"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/showcase-gen.py",
            "description": "Regenerates showcase pages from registry"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/verify-gate.py",
            "description": "Blocks completion without verification"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/docs-gate.py",
            "description": "Blocks completion without documentation"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ralph-loop.py",
            "description": "Forces continuation until completion promise detected"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/reground.py",
            "description": "Re-injects state context every 7 turns"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/capacity-warning.py",
            "description": "Warns at 50/75/90% context capacity"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/completion-links.py",
            "description": "Shows dashboard and showcase links at workflow completion"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-verify.py",
            "description": "Verifies subagent deliverables match spec"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-manager.py",
            "description": "Initializes state and injects workflow context"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/notify.py",
            "description": "Sends NTFY push notification when awaiting input"
          }
        ]
      }
    ]
  }
}
